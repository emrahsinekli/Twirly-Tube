{
  "name": "twirly-tube",
  "version": "0.1.0",
  "description": "Twirly Tube — bamboo pole + spiral tube climbing game (Phaser 3 + TypeScript + Vite + Capacitor)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap run android",
    "cap:ios": "npm run cap:sync && cap run ios"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emrahsinekli/Twirly-Tube"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
